<DrawPage name="喷房逻辑设定帮助界面" bk_transparent="0" bk_color="0;0;255" bk_image="images\逻辑设定界面.jpg" size_option="0" width="1024" height="600"><item name="Button1" id="1" type="button" button_type="0" focus="1" notify_disable="0" key_code="a" key_type="0" init_state="0" button_style="0" longpress_delay="0" url_down="" url_up="" popup_menu_id="0" input_text_id="0" switch="喷放逻辑设定" switch_effect="0" switch_area="0" switch_area_left="0" switch_area_right="0" switch_area_top="0" switch_area_bottom="0" action="" xOffset="902" yOffset="523" width="112" height="40" cut_up="0" cut_up_offset_x="0" cut_up_offset_y="0" cut_down="0" cut_down_offset_x="0" cut_down_offset_y="0" custom_data_up="" custom_data_down="" external_data_up="" external_data_down="" external_data_delay="100" child_screen="0" need_login="0" login_password="888888" show_text_state="0" font="7" font_color_up="255;255;255" font_color_down="255;255;255" text_state_up="" text_state_down="" bind_variant="" show_condition="0" condition_variant="" condition_value="0"/><item name="Text2" id="2" type="text" multi_lang="1" text_align="0" text_align_v="1" text="1、灭火装置选择，根据实际接入的钢瓶数量选择" text1="" text2="" text3="" text4="" text5="" text6="" text7="" text8="" text9="" text10="" text11="" text12="" text13="" text14="" text15="" font="6" encode="1" show_bk="0" fore_color="0;0;0" bk_color="255;255;255" xOffset="8" yOffset="10" width="443" height="33" row_gap="0" col_gap="0"/><item name="Text1" id="3" type="text" multi_lang="1" text_align="0" text_align_v="1" text="2、工作方式选择,如果接入两个钢瓶,根据钢瓶的连接方式来选择工作方式,例如两个钢瓶一个接到仓,一个接到簇,则工作方式为独立;如果两个钢瓶接在一起同时为仓和簇提供灭火药剂,则为协同" text1="" text2="" text3="" text4="" text5="" text6="" text7="" text8="" text9="" text10="" text11="" text12="" text13="" text14="" text15="" font="6" encode="1" show_bk="0" fore_color="0;0;0" bk_color="255;255;255" xOffset="9" yOffset="45" width="443" height="88" row_gap="0" col_gap="0"/></DrawPage>
